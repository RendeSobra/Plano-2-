# Copie este arquivo com o nome .env e preencha os valores.
# O .env guarda as chaves secretas e NUNCA vai para o Git.

# Token do bot, dado pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=

# Chave da API do Gemini, criada no Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modelo do Gemini (padrão) e reserva para quando o principal estiver sobrecarregado
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_RESERVA=gemini-3.6-flash

# Chave da API do Claude (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# Escada do Claude (IDs exatamente assim, sem data no final):
# barato = trocar prato e substituto do Gemini; padrão = cardápio; forte = só por escalonamento
CLAUDE_MODELO_BARATO=claude-haiku-5-5
CLAUDE_MODELO_PADRAO=claude-sonnet-5-5
CLAUDE_MODELO_FORTE=claude-opus-5-5
# Limite de chamadas por dia de cada modelo; no limite, o roteador fica no nível de baixo
LIMITE_HAIKU_DIA=500
LIMITE_SONNET_DIA=100
LIMITE_OPUS_DIA=20
# Quanto o Sonnet "pensa" ao montar o cardápio (low, medium ou high). O raciocínio é cobrado
# como saída: "low" deixa o cardápio mais barato; se for reprovado, o Opus refaz com "medium".
ESFORCO_CARDAPIO=low

# Quantas mensagens cada pessoa pode mandar por dia
LIMITE_MSG_DIA=30

# IDs do Telegram dos administradores (separados por vírgula): /custos, /promo, /coletar
ADMIN_IDS=

# Arquivo do banco de dados SQLite
BANCO_ARQUIVO=rende.db

# Minutos até a mensagem com o PDF da lista sumir sozinha do chat
APAGAR_PDF_APOS_MIN=5

# Opcional: cotação do dólar para o /custos mostrar também em reais (ex.: 5.40)
COTACAO_DOLAR=

# Coletor de promoções (C13): roda 1 vez por dia neste horário (Brasília) e no /coletar.
# Usa só o Gemini. Lojas de Goiânia de cada rede (como aparecem no endereço do site).
COLETOR_HORA=06:00
COLETOR_MAX_ENCARTES=8
COLETOR_ATACADAO_LOJAS=goiania-avenida-independencia
COLETOR_DIAADIA_LOJAS=goiania-setor-novo-horizonte,goiania-balneario

# Mercados próximos (C12, OpenStreetMap/Overpass): raio da busca em metros e servidores
# (separados por vírgula; o segundo só é usado se o primeiro estiver lotado)
RAIO_MERCADOS_M=3000
OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Registra no log o tempo de cada etapa do toque num botão (1 = ligado; use só para medir)
RENDE_MEDIR_LATENCIA=
