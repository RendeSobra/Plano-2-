# Copie este arquivo com o nome .env e preencha os valores.
# O .env guarda as chaves secretas e NUNCA vai para o Git.

# Token do bot, dado pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=

# Chave da API do Gemini, criada no Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modelo do Gemini (padrão) e reserva para quando o principal estiver sobrecarregado
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_RESERVA=gemini-3.6-flash

# Chave da API do Claude (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# Escada do Claude (IDs exatamente assim, sem data no final):
# barato = trocar prato e substituto do Gemini; padrão = cardápio; forte = só por escalonamento
CLAUDE_MODELO_BARATO=claude-haiku-5-5
CLAUDE_MODELO_PADRAO=claude-sonnet-5-5
CLAUDE_MODELO_FORTE=claude-opus-5-5
# Limite de chamadas por dia de cada modelo; no limite, o roteador fica no nível de baixo
LIMITE_HAIKU_DIA=500
LIMITE_SONNET_DIA=100
LIMITE_OPUS_DIA=20

# Quantas mensagens cada pessoa pode mandar por dia
LIMITE_MSG_DIA=30

# IDs do Telegram dos administradores (separados por vírgula): /custos, /promo, /coletar
ADMIN_IDS=

# Arquivo do banco de dados SQLite
BANCO_ARQUIVO=rende.db

# Opcional: cotação do dólar para o /custos mostrar também em reais (ex.: 5.40)
COTACAO_DOLAR=
